#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_root="$(cd -- "$script_dir/.." && pwd)"
if [[ -f "$source_root/app/shell.qml" ]]; then
  default_root="$source_root"
else
  default_root="$(cd -- "$script_dir/../share/learn-omarchy" && pwd)"
fi
app_root="${LEARN_OMARCHY_ROOT:-$default_root}"
course="${LEARN_OMARCHY_COURSE:-$app_root/courses/omarchy-basics.json}"
character="${LEARN_OMARCHY_CHARACTER:-}"

while (($# > 0)); do
  case "$1" in
    --course)
      [[ $# -ge 2 ]] || { echo "learn-omarchy: --course requires a path" >&2; exit 2; }
      course="$2"
      shift 2
      ;;
    --character)
      [[ $# -ge 2 ]] || { echo "learn-omarchy: --character requires a name" >&2; exit 2; }
      character="$2"
      shift 2
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: learn-omarchy [--course PATH] [--character NAME]

Run an interactive, theme-aware Omarchy course. Characters live under
assets/characters/<NAME>; the default is hexon.
USAGE
      exit 0
      ;;
    *)
      echo "learn-omarchy: unknown argument '$1'" >&2
      exit 2
      ;;
  esac
done

for command in node qs mpv; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "learn-omarchy: required command not found: $command" >&2
    exit 1
  }
done

course="$(realpath -- "$course")"
course_dir="$(dirname -- "$course")"
node --experimental-strip-types "$app_root/tools/validate-course.ts" "$course"
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/learn-omarchy"

# Only an explicit choice becomes an override; otherwise the app shows the
# coach picker on first run and remembers the selection.
if [[ -n "$character" ]]; then
  [[ -d "$app_root/assets/characters/$character/sprites" ]] || {
    echo "learn-omarchy: unknown character '$character' (no $app_root/assets/characters/$character/sprites)" >&2
    exit 2
  }
  export LEARN_OMARCHY_CHARACTER="$character"
fi
export LEARN_OMARCHY_ROOT="$app_root"
export LEARN_OMARCHY_COURSE="$course"
export LEARN_OMARCHY_COURSE_DIR="$course_dir"
exec qs --no-duplicate --path "$app_root/app"
