  "steps": [
    { "type": "sound", "cue": "birds-welcome.opus" },
    {
      "type": "parallel", "branches": [
        [
          {
            "type": "parallel", "branches": [
              [{ "type": "tween", "target": "canopy", "to": { "scale": 1 }, "duration": 1000, "easing": "outBack" }],
              [{ "type": "tween", "target": "stars", "to": { "opacity": 1 }, "duration": 450, "easing": "inOutSine" }],
              [{ "type": "tween", "target": "prompt", "to": { "opacity": 1 }, "duration": 450, "easing": "inOutSine" }],
              [{ "type": "wait", "duration": 300 }, { "type": "tween", "target": "fireflies", "to": { "opacity": 1 }, "duration": 800 }]
