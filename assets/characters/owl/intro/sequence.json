          },
          { "type": "set", "target": "prompt", "to": { "text": "> {displayName} IS AWAKE." } },
          { "type": "set", "target": "character", "to": { "visible": true } },
          { "type": "tween", "target": "character", "to": { "opacity": 1 }, "duration": 320 },
          { "type": "wait", "duration": 1180 },
          { "type": "set", "target": "prompt", "to": { "text": "> TOUR STARTING" } },
          { "type": "set", "target": "character", "to": { "flying": true, "facing": 1 } },
          { "type": "tween", "target": "character", "to": { "offsetY": -32 }, "duration": 450, "easing": "outQuad" },
          {
            "type": "parallel", "branches": [
              [{ "type": "tween", "target": "canopy", "to": { "opacity": 0 }, "duration": 650, "easing": "inOutSine" }],
              [{ "type": "tween", "target": "fireflies", "to": { "opacity": 0 }, "duration": 650, "easing": "inOutSine" }],
              [{ "type": "tween", "target": "stars", "to": { "opacity": 0 }, "duration": 650, "easing": "inOutSine" }],
              [{ "type": "tween", "target": "prompt", "to": { "opacity": 0 }, "duration": 650, "easing": "inOutSine" }]
            ]
          }
        ],
        [
          { "type": "tween", "target": "canopy", "to": { "rotation": 0.8 }, "duration": 1900, "easing": "inOutSine" },
          { "type": "tween", "target": "canopy", "to": { "rotation": -0.8 }, "duration": 1800, "easing": "inOutSine" }
        ]
      ]
    }
