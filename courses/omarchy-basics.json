            "type": "hyprland-layer-open",
            "namespace": "omarchy-menu"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 940,
            "height": 620,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "Keep this one handy. Whenever you're stuck, Super plus K has the answer.",
          "completionAudio": "audio/open-keybindings-done.mp3"
