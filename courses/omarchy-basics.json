    {
      "id": "workspaces",
      "title": "Workspaces",
      "description": "Move between virtual desktops while keeping your hands on the keyboard.",
      "icon": "04",
      "estimatedMinutes": 2,
      "steps": [
        {
          "id": "next-workspace",
          "instruction": "Let's hop desktops. Press Super and Tab to move to the next workspace.",
          "detail": "Workspaces keep projects separate without minimizing anything. Watch the numbers in the bar.",
          "keys": [
            "SUPER",
            "+",
            "TAB"
          ],
          "audio": "audio/next-workspace.mp3",
          "help": {
            "label": "Move forward for me",
            "command": [
              "hyprctl",
              "eval",
              "hl.dispatch(hl.dsp.focus({ workspace = \"e+1\" }))"
            ]
          },
          "completion": {
            "type": "hyprland-workspace-change"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top-left",
            "x": 8,
            "y": 4,
            "width": 420,
            "height": 54,
            "borderWidth": 8,
            "radius": 10,
            "durationMs": 1700
          },
          "completionMessage": "See the highlight move in the bar? That's you on a new workspace.",
          "completionAudio": "audio/next-workspace-done.mp3"
        },
        {
          "id": "previous-workspace",
          "instruction": "Now head back. Hold Super and Shift, then press Tab to return to the previous workspace.",
          "detail": "Adding Shift reverses the direction. Super plus a number jumps straight to that workspace.",
          "keys": [
            "SUPER",
            "+",
            "SHIFT",
            "+",
            "TAB"
          ],
          "audio": "audio/previous-workspace.mp3",
          "help": {
            "label": "Move back for me",
            "command": [
              "hyprctl",
              "eval",
              "hl.dispatch(hl.dsp.focus({ workspace = \"e-1\" }))"
            ]
          },
          "completion": {
            "type": "hyprland-workspace-change"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top-left",
            "x": 8,
            "y": 4,
            "width": 420,
            "height": 54,
            "borderWidth": 8,
            "radius": 10,
            "durationMs": 1700
          },
          "completionMessage": "And you're back. By the way, Super plus any number jumps straight to that workspace.",
          "completionAudio": "audio/previous-workspace-done.mp3"
        }
      ]
    },
