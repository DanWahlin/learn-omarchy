{
  "schemaVersion": 2,
  "id": "omarchy-essentials",
  "title": "Learn Omarchy",
  "description": "Choose a short, hands-on module. Learn the shortcuts and surfaces that make Omarchy fast.",
  "lessons": [
    {
      "id": "menus-and-apps",
      "title": "Menus and apps",
      "description": "Find commands, installed apps, and the built-in shortcut guide.",
      "icon": "01",
      "estimatedMinutes": 3,
      "steps": [
        {
          "id": "open-root-menu",
          "instruction": "Open the Omarchy menu.",
          "detail": "This is the starting point for setup, styling, installation, updates, and system actions.",
          "keys": ["SUPER", "+", "SPACE"],
          "audio": "audio/open-root-menu.mp3",
          "help": {
            "label": "Open the menu for me",
            "command": ["omarchy", "menu", "summon", "root"]
          },
          "cleanup": ["omarchy", "menu", "close"],
          "completion": {
            "type": "hyprland-layer-open",
            "namespace": "omarchy-menu"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 340,
            "height": 880,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "This is the Omarchy menu. Type to search or use the arrow keys to explore."
        },
        {
          "id": "open-apps",
          "instruction": "Now open the Apps menu.",
          "detail": "Start typing an app name as soon as the menu opens.",
          "keys": ["SUPER", "+", "ALT", "+", "SPACE"],
          "audio": "audio/open-apps.mp3",
          "help": {
            "label": "Open Apps for me",
            "command": ["omarchy", "menu", "summon", "apps"]
          },
          "cleanup": ["omarchy", "menu", "close"],
          "completion": {
            "type": "hyprland-layer-open",
            "namespace": "omarchy-menu"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 340,
            "height": 880,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "Apps searches everything installed on the system and launches the selected result."
        },
        {
          "id": "open-keybindings",
          "instruction": "Open the searchable keybindings guide.",
          "detail": "Use this any time you forget a shortcut.",
          "keys": ["SUPER", "+", "K"],
          "audio": "audio/open-keybindings.mp3",
          "help": {
            "label": "Show keybindings for me",
            "command": ["omarchy", "menu", "keybindings"]
          },
          "cleanup": ["omarchy", "menu", "close"],
          "completion": {
            "type": "hyprland-layer-open",
            "namespace": "omarchy-menu"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 620,
            "height": 760,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "Search by action or shortcut. This guide reflects the bindings on your machine."
        }
      ]
    },
    {
      "id": "everyday-apps",
      "title": "Everyday apps",
      "description": "Launch the terminal, browser, and file manager without reaching for a menu.",
      "icon": "02",
      "estimatedMinutes": 3,
      "steps": [
        {
          "id": "launch-terminal",
          "instruction": "Launch your default terminal.",
          "detail": "Omarchy opens whichever terminal you selected as your default.",
          "keys": ["SUPER", "+", "RETURN"],
          "audio": "audio/launch-terminal.mp3",
          "help": {
            "label": "Launch the terminal for me",
            "command": ["omarchy", "launch", "terminal"]
          },
          "completion": {
            "type": "action-success",
            "delayMs": 700
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": -40,
            "width": 1280,
            "height": 760,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 1800
          },
          "completionMessage": "Your terminal is one shortcut away from anywhere in Omarchy."
        },
        {
          "id": "launch-browser",
          "instruction": "Launch your default browser.",
          "detail": "The shortcut follows your Omarchy default-browser setting.",
          "keys": ["SUPER", "+", "SHIFT", "+", "RETURN"],
          "audio": "audio/launch-browser.mp3",
          "help": {
            "label": "Launch the browser for me",
            "command": ["omarchy", "launch", "browser"]
          },
          "completion": {
            "type": "action-success",
            "delayMs": 900
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": -40,
            "width": 1500,
            "height": 900,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 1800
          },
          "completionMessage": "Omarchy can change the default browser later without changing the shortcut."
        },
        {
          "id": "launch-files",
          "instruction": "Launch the Files app.",
          "detail": "This opens Nautilus, Omarchy's graphical file manager.",
          "keys": ["SUPER", "+", "SHIFT", "+", "F"],
          "audio": "audio/launch-files.mp3",
          "help": {
            "label": "Launch Files for me",
            "command": ["omarchy", "launch", "nautilus"]
          },
          "completion": {
            "type": "action-success",
            "delayMs": 800
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": -40,
            "width": 1200,
            "height": 760,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 1800
          },
          "completionMessage": "Files gives you quick access to folders, drives, recent files, and network locations."
        }
      ]
    },
    {
      "id": "workspaces",
      "title": "Workspaces",
      "description": "Move between virtual desktops while keeping your hands on the keyboard.",
      "icon": "03",
      "estimatedMinutes": 2,
      "steps": [
        {
          "id": "next-workspace",
          "instruction": "Move to the next workspace.",
          "detail": "Workspaces keep projects and activities separated without minimizing windows.",
          "keys": ["SUPER", "+", "TAB"],
          "audio": "audio/next-workspace.mp3",
          "help": {
            "label": "Move forward for me",
            "command": ["hyprctl", "eval", "hl.dispatch(hl.dsp.focus({ workspace = \"e+1\" }))"]
          },
          "completion": {
            "type": "action-success",
            "delayMs": 300
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top-left",
            "x": 8,
            "y": 4,
            "width": 420,
            "height": 54,
            "borderWidth": 8,
            "radius": 10,
            "durationMs": 1700
          },
          "completionMessage": "The workspace indicator in the bar follows you to the next virtual desktop."
        },
        {
          "id": "previous-workspace",
          "instruction": "Return to the previous workspace.",
          "detail": "Adding Shift reverses the direction of the workspace shortcut.",
          "keys": ["SUPER", "+", "SHIFT", "+", "TAB"],
          "audio": "audio/previous-workspace.mp3",
          "help": {
            "label": "Move back for me",
            "command": ["hyprctl", "eval", "hl.dispatch(hl.dsp.focus({ workspace = \"e-1\" }))"]
          },
          "completion": {
            "type": "action-success",
            "delayMs": 300
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top-left",
            "x": 8,
            "y": 4,
            "width": 420,
            "height": 54,
            "borderWidth": 8,
            "radius": 10,
            "durationMs": 1700
          },
          "completionMessage": "You're back where you started. Number shortcuts such as Super plus 1 jump directly."
        }
      ]
    },
    {
      "id": "bar-panels",
