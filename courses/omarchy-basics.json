        {
          "id": "calendar-panel",
          "instruction": "Open the Calendar panel.",
          "detail": "The clock panel includes a month view and timezone tools.",
          "keys": ["SUPER", "+", "CTRL", "+", "ALT", "+", "D"],
          "audio": "audio/calendar-panel.mp3",
          "help": {
            "label": "Open Calendar for me",
            "command": ["omarchy-shell", "shell", "summon", "omarchy.clock"]
          },
          "cleanup": ["omarchy-shell", "shell", "hide", "omarchy.clock"],
          "completion": {
            "type": "action-success",
            "delayMs": 350
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top",
            "x": 0,
            "y": 34,
            "width": 520,
            "height": 500,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 1900
          },
          "completionMessage": "Clicking the bar clock opens the same panel; right-click cycles its display format."
        }
      ]
    },
