            "y": 0,
            "width": 340,
            "height": 880,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "There it is. Type to search or use the arrows, and Escape backs out whenever you like.",
          "completionAudio": "audio/open-root-menu-done.mp3"
        },
        {
          "id": "open-apps",
          "instruction": "Now for your apps. Hold Super and Alt, then tap Space, and the Apps menu opens.",
          "detail": "The Apps menu lists everything installed. Start typing and the list narrows instantly.",
          "keys": [
            "SUPER",
            "+",
            "ALT",
            "+",
            "SPACE"
          ],
          "audio": "audio/open-apps.mp3",
          "help": {
            "label": "Open Apps for me",
            "command": [
              "omarchy",
              "menu",
              "summon",
              "apps"
            ]
          },
          "cleanup": [
            "omarchy",
            "menu",
            "close"
          ],
          "completion": {
            "type": "hyprland-layer-open",
            "namespace": "omarchy-menu"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 340,
            "height": 880,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "Nice. Type a few letters, hit Enter, and the app launches. No mouse required.",
          "completionAudio": "audio/open-apps-done.mp3"
        },
        {
          "id": "open-keybindings",
          "instruction": "Forget a shortcut? Press Super and K to see every keybinding at once.",
          "detail": "This searchable list is your cheat sheet. Type any word to filter it.",
