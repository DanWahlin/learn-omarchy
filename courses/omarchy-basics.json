{
  "schemaVersion": 2,
  "id": "omarchy-essentials",
  "title": "Learn Omarchy",
  "description": "Choose a short, hands-on module. Learn the shortcuts and surfaces that make Omarchy fast.",
  "lessons": [
    {
      "id": "omarchy-tour",
      "title": "Omarchy tour",
      "description": "Let HEXON introduce the menu bar, then open the Omarchy menu with your first hotkey.",
      "icon": "01",
      "estimatedMinutes": 2,
      "steps": [
        {
          "id": "tour-workspaces",
          "kind": "tour",
          "instruction": "Workspaces sit at the left of the bar. Each number is a virtual desktop, and the highlighted one is where you are now.",
          "detail": "HEXON is giving the tour. Press Enter to continue early, or Skip to jump ahead.",
          "keys": [],
          "audio": "audio/tour-workspaces.mp3",
          "completion": {
            "type": "narration-complete",
            "delayMs": 900,
            "durationMs": 6000
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top-left",
            "x": 8,
            "y": 1,
            "width": 180,
            "height": 27,
            "borderWidth": 3,
            "radius": 8,
            "dynamic": "workspaces",
            "durationMs": 1200
          }
        },
        {
          "id": "tour-clock",
          "kind": "tour",
          "instruction": "The middle of the bar shows the date and time, and it doubles as your calendar.",
          "detail": "HEXON is giving the tour. Press Enter to continue early, or Skip to jump ahead.",
          "keys": [],
          "audio": "audio/tour-clock.mp3",
          "completion": {
            "type": "narration-complete",
            "delayMs": 900,
            "durationMs": 5000
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top",
            "x": 0,
            "y": 1,
            "width": 230,
            "height": 27,
            "borderWidth": 3,
            "radius": 8,
            "durationMs": 1200
          }
        },
        {
          "id": "tour-status",
          "kind": "tour",
          "instruction": "The right side is your status area: network, Bluetooth, audio, display, and battery. Each one opens a panel.",
          "detail": "HEXON is giving the tour. Press Enter to continue early, or Skip to jump ahead.",
          "keys": [],
          "audio": "audio/tour-status.mp3",
          "completion": {
            "type": "narration-complete",
            "delayMs": 900,
            "durationMs": 6000
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "top-right",
            "x": -14,
            "y": 1,
            "width": 350,
            "height": 27,
            "borderWidth": 3,
            "radius": 8,
            "durationMs": 1200
          }
        },
        {
          "id": "tour-omarchy-menu",
          "instruction": "Now press your first hotkey to open the Omarchy menu.",
          "detail": "From this menu you can pick an app, change settings, and reach everything else in Omarchy.",
          "keys": ["SUPER", "+", "SPACE"],
          "audio": "audio/tour-omarchy-menu.mp3",
          "help": {
            "label": "Open it for me",
            "command": ["omarchy", "menu", "summon", "root"]
          },
          "cleanup": ["omarchy", "menu", "close"],
          "completion": {
            "type": "hyprland-layer-open",
            "namespace": "omarchy-menu"
          },
          "highlight": {
            "shape": "rectangle",
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 620,
            "height": 760,
            "borderWidth": 10,
            "radius": 12,
            "durationMs": 2200
          },
          "completionMessage": "That's the Omarchy menu. Type an app name or use the arrows, then press Enter to launch it."
        }
      ]
    },
