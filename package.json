{
  "name": "learn-omarchy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "geometry:install": "node tools/install-geometry-provider.mjs",
    "audio:generate": "node --experimental-strip-types tools/generate-course-audio.ts courses/omarchy-basics.json",
    "audio:normalize": "node --experimental-strip-types tools/normalize-course-audio.ts courses/audio",
    "character:prepare": "tools/prepare-hexon-sprites.sh",
    "check": "node --experimental-strip-types tools/validate-course.ts courses/omarchy-basics.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME=generic QT_QUICK_CONTROLS_STYLE=Basic QML_XHR_ALLOW_FILE_READ=1 /usr/lib/qt6/bin/qmltestrunner -input tests/qml"
  }
}
