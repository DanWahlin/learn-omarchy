# Generated by tools/prepare-release.mjs from a specific, checksummed source archive.
pkgname=learn-omarchy
pkgver=@VERSION@
pkgrel=1
pkgdesc="Interactive, theme-aware courses for learning Omarchy"
arch=('any')
url="https://github.com/DanWahlin/learn-omarchy"
license=(@LICENSES@)
depends=(
  'bash' 'coreutils' 'sudo' 'hyprland' 'mpv' 'nodejs>=22.6' 'omarchy>=4.0.3'
  'quickshell>=0.3' 'qt6-declarative' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'xdg-utils'
  'xdg-terminal-exec' 'nautilus'
  'ttf-liberation' 'noto-fonts-emoji'
  'grim' 'slurp' 'gpu-screen-recorder' 'util-linux' 'ffmpeg'
)
makedepends=('make')
optdepends=(
  'btop: activity-monitor practice'
  'tesseract: OCR practice'
  'tesseract-data-eng: English OCR sample recognition'
  'zbar: QR recognition (zbarimg)'
  'qrencode: QR sample creation'
  'voxtype: optional dictation practice'
)
options=('!strip')
source=("learn-omarchy-$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "$srcdir/learn-omarchy-$pkgver"
  node tools/prepare-release.mjs --check .
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
